# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Credentials and local editor settings
.env
.env.*
.vscode/
.idea/

# Original inputs and temporary generation artifacts remain local
/input/
/output/*
!/output/architecture_spec.json
!/output/generation_plan.json
!/output/space-fractions/

# Publish only the generated example's source, dependencies, README, and tests
/output/space-fractions/*
!/output/space-fractions/src/
!/output/space-fractions/tests/
!/output/space-fractions/package.json
!/output/space-fractions/package-lock.json
!/output/space-fractions/README.md
!/output/space-fractions/architecture_spec.json
node_modules/
*.log

# Keep optional container files local
Dockerfile
.dockerignore

# Test reports and coverage remain local; formal tests are versioned
.pytest_cache/
.coverage*
htmlcov/
coverage/

# Publish README only; retain other Markdown documents locally
*.[mM][dD]
!README.md
